<h1>Users</h1>
<p><%= link_to "New user", new_user_path, class: "button" %></p>

<table>
  <thead>
  <tr>
    <th>Email</th>
    <th>Role</th>
    <th></th>
  </tr>
  </thead>
  <tbody>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.email_address %></td>
      <td><%= user.role.humanize %></td>
      <td><%= link_to "Edit", edit_user_path(user) %></td>
    </tr>
  <% end %>
  </tbody>
</table>