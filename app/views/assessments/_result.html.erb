<% editable = @assessment.editable? && Current.user.can_test? %>
<div class="result" id="<%= dom_id(result) %>">
  <% if editable %>
    <%= form_with model: result, url: control_result_path(result), class: "result-form" do |f| %>
      <span class="ref"><%= result.control.ref %></span>
      <span class="desc"><%= result.control.description %>
        <small class="muted">(<%= [result.control.owasp, result.control.cwe_nist].compact_blank.join(" · ") %>)</small></span>
      <span class="col-status">
        <%= f.select :status, ControlResult.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "select-#{result.status}" %>
      </span>
      <span class="col-sev">
        <%= f.select :severity, ControlResult.severities.keys.map { |s| [s.humanize, s] } %>
      </span>
      <span class="col-comments"><%= f.text_field :comments, placeholder: "Comments" %></span>
      <span class="col-owner"><%= f.text_field :owner, placeholder: "Owner" %></span>
      <%= f.submit "Save" %>
    <% end %>
  <% else %>
    <div class="result-form">
      <span class="ref"><%= result.control.ref %></span>
      <span class="desc"><%= result.control.description %>
        <small class="muted">(<%= [result.control.owasp, result.control.cwe_nist].compact_blank.join(" · ") %>)</small></span>
      <span class="col-status"><span class="pill pill-<%= result.status %>"><%= result.status.humanize %></span></span>
      <span class="col-sev sev sev-<%= result.severity %>"><%= result.severity.humanize %></span>
      <span class="col-comments"><%= result.comments %></span>
      <span class="col-owner"><%= result.owner %></span>
    </div>
  <% end %>
  <% if result.requires_evidence? %>
    <div class="evidence <%= result.evidence_complete? ? 'ok' : 'missing' %>">
      <%= result.evidence_complete? ? "Evidence complete" : "MISSING EVIDENCE" %>:
      <% result.findings.each do |finding| %>
        <%= link_to(finding.category.presence || "Finding ##{finding.id}", finding) %>
        (<%= finding.evidences.size %>)
      <% end %>
      <% if editable %><%= link_to "Add finding", new_assessment_finding_path(@assessment, control_result_id: result.id) %>
      <% end %>
    </div>
  <% end %>
</div>